<resources>
    <!-- Base application theme with Skeuomorphic styling -->
    <style name="Theme.DermaTrace" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/primary_teal</item>
        <item name="colorPrimaryVariant">#0369A1</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">#0EA5E9</item>
        <item name="colorSecondaryVariant">#0284C7</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        
        <!-- Status bar and navigation bar: OLED black with white icons, eliminating any white top borders on all devices -->
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
    </style>
</resources>
